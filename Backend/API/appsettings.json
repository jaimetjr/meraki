{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "MerakiAPI",
    "Audience": "MerakiAPI",
    "ExpirationMinutes": 120
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },
  "Storage": {
    "Provider": "Local",
    "PublicBaseUrl": "http://localhost:5063/uploads"
  },
  "Email": {
    "Mode": "Smtp",
    "Smtp": {
      "Port": 587
    }
  },
  "Contact": {
    "RateLimitPerHour": 10
  }
}
